From ff7e65e400d5c9e1c35de7b39a5008239d9ce37d Mon Sep 17 00:00:00 2001
From: unknown <lahkimi.maziz@gmail.com>
Date: Tue, 27 Oct 2026 21:42:54 +0100
Subject: [PATCH] Gravite dans le paquet posture (v7 etendu, 281 octets) pour
 redresser l'avatar

Lit l'accelerometre (sensors_plus), le lisse, l'exprime dans les axes des
worldLandmarks (x droite, y bas, z loin de la camera) selon camera avant/arriere
et l'ajoute apres les 33 points : 3 x int16 (vecteur unitaire x 30000).
La version reste 7 : un decodeur qui ignore les octets en trop lit le paquet comme avant.
Controle terrain : log "gravity up=" (telephone droit en portrait -> (0, -1, 0)).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 lib/core/gravity_service.dart                | 99 ++++++++++++++++++++
 lib/data/posture_codec.dart                  | 23 ++++-
 lib/viewmodels/controls_viewmodel.dart       |  2 +
 lib/viewmodels/pose_detection_viewmodel.dart |  4 +
 pubspec.yaml                                 |  1 +
 5 files changed, 128 insertions(+), 1 deletion(-)
 create mode 100644 lib/core/gravity_service.dart

diff --git a/lib/core/gravity_service.dart b/lib/core/gravity_service.dart
new file mode 100644
index 0000000..e69b29b
--- /dev/null
+++ b/lib/core/gravity_service.dart
@@ -0,0 +1,99 @@
+import 'dart:async';
+import 'dart:math' as math;
+
+import 'package:flutter/foundation.dart' show debugPrint;
+import 'package:sensors_plus/sensors_plus.dart';
+
+/// Direction « vers le haut » (opposée à la gravité), exprimée dans les axes
+/// des worldLandmarks MediaPipe, pour que le viewer redresse l'avatar quand la
+/// caméra est penchée (plongée, téléphone incliné, tenu à la main).
+///
+/// Axes des worldLandmarks (image non retournée, téléphone en portrait) :
+///   x vers la droite de l'image, y vers le bas, z en s'éloignant de la caméra.
+///
+/// L'accéléromètre Android lit +9,8 m/s² vers le HAUT à l'arrêt (téléphone
+/// droit : y = +9,8). Axes du téléphone : x à droite, y en haut, z hors de
+/// l'écran (vers l'utilisateur).
+///   Caméra avant  : image x = −x téléphone, image y(bas) = −y, profondeur = +z
+///   Caméra arrière: image x = +x téléphone, image y(bas) = −y, profondeur = −z
+/// Contrôle : téléphone droit (portrait), le vecteur renvoyé vaut ≈ (0, −1, 0).
+class GravityService {
+  GravityService._();
+  static final GravityService instance = GravityService._();
+
+  /// À tenir à jour lors du changement de caméra (ControlsViewModel.switchCamera).
+  bool frontCamera = true;
+
+  StreamSubscription<AccelerometerEvent>? _sub;
+  bool _hasValue = false;
+  double _x = 0, _y = 0, _z = 0;
+
+  /// Lissage exponentiel du vecteur unitaire : ~0,1 s de constante de temps à
+  /// 50 Hz. Retire les secousses sans retarder visiblement un changement
+  /// d'inclinaison.
+  static const double _alpha = 0.1;
+
+  void start() {
+    if (_sub != null) return;
+    try {
+      _sub = accelerometerEventStream(
+        samplingPeriod: SensorInterval.normalInterval,
+      ).listen(
+        _onEvent,
+        onError: (Object error) {
+          _hasValue = false;
+          debugPrint('⚠️ Accéléromètre indisponible : $error');
+        },
+      );
+    } catch (error) {
+      debugPrint('⚠️ Accéléromètre indisponible : $error');
+    }
+  }
+
+  void stop() {
+    _sub?.cancel();
+    _sub = null;
+    _hasValue = false;
+  }
+
+  DateTime _lastLog = DateTime.fromMillisecondsSinceEpoch(0);
+
+  void _onEvent(AccelerometerEvent e) {
+    final n = math.sqrt(e.x * e.x + e.y * e.y + e.z * e.z);
+    // Chute libre ou capteur muet : pas de direction exploitable.
+    if (!n.isFinite || n < 1.0) return;
+    final ux = e.x / n, uy = e.y / n, uz = e.z / n;
+    if (!_hasValue) {
+      _x = ux;
+      _y = uy;
+      _z = uz;
+      _hasValue = true;
+    } else {
+      _x += (ux - _x) * _alpha;
+      _y += (uy - _y) * _alpha;
+      _z += (uz - _z) * _alpha;
+    }
+    // Contrôle sur le terrain (logcat) : téléphone droit en portrait → up ≈ (0.00, -1.00, 0.00).
+    final now = DateTime.now();
+    if (now.difference(_lastLog) >= const Duration(seconds: 2)) {
+      _lastLog = now;
+      final up = upInCameraAxes;
+      if (up != null) {
+        debugPrint(
+          '🧭 gravity up=(${up[0].toStringAsFixed(2)}, ${up[1].toStringAsFixed(2)}, ${up[2].toStringAsFixed(2)}) '
+          'camera=${frontCamera ? 'avant' : 'arrière'}',
+        );
+      }
+    }
+  }
+
+  /// Vecteur unitaire « haut » dans les axes de l'image (x droite, y bas,
+  /// z s'éloignant de la caméra), ou null si le capteur n'a rien donné.
+  List<double>? get upInCameraAxes {
+    if (!_hasValue) return null;
+    final n = math.sqrt(_x * _x + _y * _y + _z * _z);
+    if (n < 0.5) return null;
+    final ux = _x / n, uy = _y / n, uz = _z / n;
+    return frontCamera ? [-ux, -uy, uz] : [ux, -uy, -uz];
+  }
+}
diff --git a/lib/data/posture_codec.dart b/lib/data/posture_codec.dart
index 8eba726..7371154 100644
--- a/lib/data/posture_codec.dart
+++ b/lib/data/posture_codec.dart
@@ -16,6 +16,11 @@ import 'package:flutter_pose_detection/flutter_pose_detection.dart';
 ///   7-8    largeur de frame (uint16)
 ///   9-10   hauteur de frame (uint16)
 ///
+/// Extension optionnelle « gravité » (6 octets, après les 33 points, paquet de 281 octets) :
+///   3 × int16 big-endian = direction « haut » dans les axes des worldLandmarks
+///   (x droite, y bas, z s'éloignant de la caméra), vecteur unitaire × 30000.
+///   La version reste 7 : un décodeur qui ignore les octets en trop lit le paquet comme avant.
+///
 /// Point (8 octets, ordre fixe défini par [sent]) :
 ///   x image 12 bits | y image 12 bits | world x/y/z 12 bits chacun | visibilité 4 bits
 ///   image x/y : plage normalisée [-0.5, 1.5]
@@ -43,6 +48,8 @@ class PostureCodec {
   ];
 
   static final int packetSize = headerSize + sent.length * pointSize; // 275
+  static const int gravitySize = 6;
+  static const double gravityScale = 30000;
 
   static const Map<String, int> _labelToCode = {
     'debout': 0,
@@ -79,6 +86,7 @@ class PostureCodec {
     required Size frameSize,
     required int seq,
     required int timestampMs,
+    List<double>? gravity,
   }) {
     final byType = <int, PoseLandmark>{
       for (final l in landmarks) l.type.value: l,
@@ -87,7 +95,11 @@ class PostureCodec {
       for (final l in worldLandmarks) l.typeIndex: l,
     };
 
-    final bd = ByteData(packetSize);
+    final List<double>? up =
+        (gravity != null && gravity.length == 3 && gravity.every((g) => g.isFinite))
+            ? gravity
+            : null;
+    final bd = ByteData(packetSize + (up != null ? gravitySize : 0));
     bd.setUint8(0, version);
     bd.setUint8(1, labelToCode(label));
     bd.setUint8(
@@ -138,6 +150,15 @@ class PostureCodec {
       o += pointSize;
     }
 
+    if (up != null) {
+      for (var i = 0; i < 3; i++) {
+        bd.setInt16(
+          o + i * 2,
+          (up[i].clamp(-1.0, 1.0) * gravityScale).round(),
+        );
+      }
+    }
+
     return bd.buffer.asUint8List();
   }
 
